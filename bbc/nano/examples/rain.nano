; Falling turtles on a canvas that is a torus in y (32 rows x 8 = 256 exactly),
; so the rain never ends and nothing is ever cleared.

back 000
plan
    0:000 1:00F 2:08F 3:8FF 4:FFF 5:0F8 6:880 7:F08

proc main
    fork sow 2 1

proc sow x c
    jump x 0
    fork drop 26 c
    wait 2
    when x < 150
        fork sow x+8 c+1
    done

proc drop n c
    face 64
    tint c
    size 0
    draw
    move 4
    wait 1
    when n > 0
        fork drop n-1 c
    done
